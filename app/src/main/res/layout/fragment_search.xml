<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_soundtrack_search"
        android:textColor="@color/purple_200"
        android:textSize="@dimen/screen_title_size"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <SearchView
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Find..."
        android:iconifiedByDefault="false"
        android:background="?android:attr/selectableItemBackground"
        android:layout_marginBottom="16dp" />

    <!-- Container for default browse categories -->
    <LinearLayout
        android:id="@+id/layout_browse_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_browse_by"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="@dimen/bold_text_size"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/btn_browse_release_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_browse_release_date"
            android:textColor="@color/gray"
            android:padding="16dp"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/btn_browse_genre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_browse_genre"
            android:textColor="@color/gray"
            android:padding="16dp"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/btn_browse_most_popular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_browse_most_popular"
            android:textColor="@color/gray"
            android:padding="16dp"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/btn_browse_highest_rated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_browse_highest_rated"
            android:textColor="@color/gray"
            android:padding="16dp"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>